# ============================================================
# Digital Kangaroos - Email & SMTP Environment Variables
# ============================================================
# NOTE: Create a .env.local file in the project root on your server
# and restart the Next.js / PM2 service after updating.

# 1. Gmail SMTP Setup (Recommended)
# To generate a 16-character App Password:
# 1) Go to: https://myaccount.google.com/apppasswords
# 2) Enable 2-Step Verification if not already enabled
# 3) Create an App Password for "Mail" / "Next.js Website"
# 4) Paste the 16-character code below (no spaces needed)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 2. Where emails should be delivered
MAIL_TO=info@digitalkangaroos.com

# 3. Optional: Custom destination per form type
# MAIL_TO_CONTACT=contact@digitalkangaroos.com
# MAIL_TO_BLOG=blog@digitalkangaroos.com
# MAIL_TO_NEWSLETTER=newsletter@digitalkangaroos.com
# MAIL_TO_APPLY=hr@digitalkangaroos.com

# 4. Optional: Custom SMTP (if using cPanel / Hostinger / Brevo instead of Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-password

